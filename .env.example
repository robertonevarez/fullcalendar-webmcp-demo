# Protocol Tooling environment
#
# Copy to .env.local (Next.js and npm scripts load this file):
#   cp .env.example .env.local
# If you already have PlanetScale credentials in .env.planetscale.local:
#   cp .env.planetscale.local .env.local

# Canonical app connection string (PlanetScale Postgres).
# Production / challenge: use the PgBouncer pooled endpoint on port 6432.
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/postgres?sslmode=verify-full
#
# Local optional Postgres for development/tests only (NOT production):
# DATABASE_URL=postgresql://localhost:5432/protocoltooling_dev
DATABASE_URL=

# Optional direct Postgres URL for DDL migrations (PlanetScale port 5432).
# If unset, db:migrate uses DATABASE_URL.
# DATABASE_MIGRATE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full

# Optional. When set, POST /api/demo/reset with
#   Authorization: Bearer <token>
# restores mutable demo appointment state (does not drop schema).
DEMO_RESET_TOKEN=

# Optional pool size for the Node `pg` Pool (default 5). PgBouncer remains the
# primary multiplexer on PlanetScale.
# PG_POOL_MAX=5
